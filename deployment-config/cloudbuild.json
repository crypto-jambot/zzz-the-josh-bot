{
  "steps": [
    {
      "name": "gcr.io/cloud-builders/docker",
      "id": "Dockerizing application",
      "args": [
        "build",
        "-f",
        "deployment-config/Dockerfile",
        "-t",
        "gcr.io/$PROJECT_ID/bigquery-token-enricher:$COMMIT_SHA",
        "."
      ]
    },
    {
      "name": "gcr.io/cloud-builders/docker",
      "id": "Pushing docker image to container registry",
      "args": ["push", "gcr.io/$PROJECT_ID/bigquery-token-enricher:$COMMIT_SHA"]
    },
    {
      "name": "gcr.io/google.com/cloudsdktool/cloud-sdk",
      "id": "Deploying to US central",
      "entrypoint": "gcloud",
      "args": [
        "run",
        "deploy",
        "bigquery-token-enricher",
        "--image",
        "gcr.io/$PROJECT_ID/bigquery-token-enricher:$COMMIT_SHA",
        "--region",
        "us-central1",
        "--service-account",
        "${_SERVICE_ACCOUNT}",
        "--set-env-vars",
        "ALCHEMY_API_KEY=${_ALCHEMY_API_KEY}",
        "--set-env-vars",
        "INFURA_API_KEY=${_INFURA_API_KEY}",
        "--set-env-vars",
        "BIGQUERY_PROJECT=${_BIGQUERY_PROJECT}"
      ]
    }
  ],
  "images": ["gcr.io/$PROJECT_ID/bigquery-token-enricher:$COMMIT_SHA"],
  "options": { "substitution_option": "ALLOW_LOOSE" }
}
